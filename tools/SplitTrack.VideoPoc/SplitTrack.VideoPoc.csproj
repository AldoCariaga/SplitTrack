<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>SplitTrack.VideoPoc</AssemblyName>
    <RootNamespace>SplitTrack.VideoPoc</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- `dotnet publish` gives one exe that runs on a PC without .NET installed; the FFmpeg DLLs sit next to it. -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <FFmpegDir>$(MSBuildThisFileDirectory)..\..\third_party\ffmpeg\</FFmpegDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only what libavcodec and libavformat load; avfilter and avdevice (42 MB) are unused. -->
    <None Include="$(FFmpegDir)avcodec-*.dll;$(FFmpegDir)avformat-*.dll;$(FFmpegDir)avutil-*.dll;$(FFmpegDir)swresample-*.dll"
          Link="ffmpeg\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Target Name="CheckFFmpeg" BeforeTargets="Build" Condition="!Exists('$(FFmpegDir)VERSION.txt')">
    <Error Text="FFmpeg DLLs are missing. Run: powershell -File tools\get-ffmpeg.ps1" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SplitTrack.Capture\SplitTrack.Capture.csproj" />
    <ProjectReference Include="..\..\src\SplitTrack.Encode\SplitTrack.Encode.csproj" />
    <ProjectReference Include="..\..\src\SplitTrack.Mux\SplitTrack.Mux.csproj" />
  </ItemGroup>
</Project>
