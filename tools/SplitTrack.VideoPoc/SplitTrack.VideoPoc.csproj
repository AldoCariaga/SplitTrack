<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>SplitTrack.VideoPoc</AssemblyName>
    <RootNamespace>SplitTrack.VideoPoc</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- `dotnet publish` gives one exe that runs on a PC without .NET installed; the FFmpeg DLLs sit next to it. -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <Import Project="..\FFmpeg.targets" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\SplitTrack.Engine\SplitTrack.Engine.csproj" />
  </ItemGroup>
</Project>
