<Window x:Class="SplitTrack.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{x:Null}" Title="SplitTrack" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        SizeToContent="WidthAndHeight" Left="-10000" Top="-10000">
    <!-- The margin leaves room for the shadow and keeps the card off the screen's edge. -->
    <Border x:Name="Card" Width="340" Margin="16" CornerRadius="10" Background="#F2202024" BorderBrush="#26FFFFFF" BorderThickness="1"
            Cursor="Hand" Opacity="0" MouseLeftButtonUp="OnCardClick" MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.45" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="14,12,8,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Badge" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top" Margin="0,2,12,0">
                    <TextBlock x:Name="Glyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SPLITTRACK" FontSize="10" FontWeight="SemiBold" Foreground="#80FFFFFF" />
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MessageText" FontSize="12" Foreground="#C8FFFFFF" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#80FFFFFF"
                           Padding="6" VerticalAlignment="Top" Background="Transparent" ToolTip="Dismiss" MouseLeftButtonUp="OnCloseClick" />
            </Grid>
            <!-- Time left before the toast goes away; it stops while the mouse is over the card. -->
            <Border Grid.Row="1" Height="3" Margin="10,0,10,1" CornerRadius="1.5" ClipToBounds="True">
                <Rectangle x:Name="Countdown" RenderTransformOrigin="0,0.5" Opacity="0.8">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="CountdownScale" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>
        </Grid>
    </Border>
</Window>
