<Window x:Class="SplitTrack.App.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SplitTrack.App.ViewModels"
        Title="{Binding Title}" Width="1180" Height="900" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="OnKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Picture -->
        <Border Background="Black" CornerRadius="8" ClipToBounds="True" MouseLeftButtonUp="OnVideoClick">
            <Grid>
                <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Audio only" Foreground="#AAFFFFFF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasVideo, Converter={StaticResource InverseBoolToVisibility}}" />
                <TextBlock Text="{Binding AudioWarning}" Foreground="#FFF39C12" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Visibility="{Binding AudioWarning, Converter={StaticResource NullToVisibility}}" />
            </Grid>
        </Border>

        <!-- Transport and part to keep -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding PlayPauseCommand}" MinWidth="44" ToolTip="Play / pause (Space)">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE768;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Text" Value="&#xE769;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding PositionText}" VerticalAlignment="Center" Margin="12,0" MinWidth="60" FontFamily="Consolas" />
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Canvas x:Name="TrimCanvas" Height="6" VerticalAlignment="Center" Margin="9,0" IsHitTestVisible="False">
                        <Rectangle x:Name="TrimRange" Height="6" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.35" RadiusX="3" RadiusY="3" />
                    </Canvas>
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="{Binding Duration}" IsMoveToPointEnabled="True"
                            ValueChanged="OnSeekChanged" Thumb.DragStarted="OnSeekDragStarted" Thumb.DragCompleted="OnSeekDragCompleted" />
                </Grid>
                <TextBlock Grid.Column="3" Text="{Binding DurationText}" VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="Consolas" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="56,8,0,0">
                <Button Command="{Binding SetStartCommand}" ToolTip="Start the part here (I)">
                    <TextBlock Text="{Binding TrimStartText, StringFormat='[  From {0}'}" />
                </Button>
                <Button Command="{Binding SetEndCommand}" Margin="8,0,0,0" ToolTip="End the part here (O)">
                    <TextBlock Text="{Binding TrimEndText, StringFormat='To {0}  ]'}" />
                </Button>
                <Button Content="Whole file" Command="{Binding ClearTrimCommand}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding TrimText}" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource Caption}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Tracks: the live mix, which is also what gets exported -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Audio tracks" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="What you hear is what gets exported." Style="{StaticResource Caption}" Margin="0,2,0,10" />
                    <ItemsControl ItemsSource="{Binding Tracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlayerTrack}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding Enabled}" MinWidth="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        </CheckBox>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="28,0,0,0" ToolTip="{Binding Description}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding Enabled}">
                                        <Slider Minimum="0" Maximum="400" Value="{Binding VolumePercent}" SmallChange="5" LargeChange="25"
                                                TickFrequency="100" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                                                ToolTip="Volume: 100 % is as recorded" MouseDoubleClick="OnVolumeReset" />
                                        <ProgressBar Value="{Binding Level, Mode=OneWay}" Maximum="1" Height="4" Margin="9,2,9,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding VolumeText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="This file has no audio tracks.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tracks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Export -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Export to MP4" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Size limit" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:PlayerViewModel.SizeChoices}" SelectedItem="{Binding Size}" HorizontalAlignment="Stretch" />
                    </Grid>
                    <Grid Margin="0,0,0,8" Visibility="{Binding IsCustomSize, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="1" Text="{Binding CustomMegabytes, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:PlayerViewModel.HeightChoices}" SelectedValuePath="Value" SelectedValue="{Binding Height}" HorizontalAlignment="Stretch" />
                    </Grid>
                    <CheckBox Content="Start exactly at 'From' (re-encodes)" IsChecked="{Binding Precise}" Margin="0,0,0,12"
                              ToolTip="Otherwise the video starts on the keyframe at or before 'From' (up to 1 s earlier), which is much faster." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Export" Command="{Binding ExportCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0"
                                Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,12,0,0"
                                 Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ExportStatus}" TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExportFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource RecordBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <WrapPanel Margin="0,8,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Copy file" Command="{Binding CopyResultCommand}" Margin="0,0,8,0" ToolTip="Then paste into Discord, a chat or a folder" />
                        <Button Content="Show in folder" Command="{Binding ShowResultCommand}" Margin="0,0,8,0" />
                        <Button Content="Play" Command="{Binding OpenResultCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
