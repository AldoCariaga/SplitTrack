<UserControl x:Class="SplitTrack.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SplitTrack.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="0,8,0,0">
        <!-- Save bar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Undo changes" Command="{Binding RevertCommand}" Margin="0,0,8,0" />
                        <Button Content="Save and apply" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource RecordBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Errors}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{StaticResource RecordBrush}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,20,24" MaxWidth="900" HorizontalAlignment="Left">

                <TextBlock Text="Library" Style="{StaticResource SectionHeader}" Margin="0,4,0,8" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding LibraryFolder, UpdateSourceTrigger=PropertyChanged}" MinWidth="360" />
                    <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseLibrary" />
                </Grid>

                <TextBlock Text="Video" Style="{StaticResource SectionHeader}" />
                <CheckBox Content="Record video (off: audio tracks only)" IsChecked="{Binding VideoEnabled}" Margin="0,0,0,10" />
                <StackPanel IsEnabled="{Binding VideoEnabled}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Content="Whole monitor" IsChecked="{Binding CaptureMonitor}" GroupName="capture" />
                        <ComboBox Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Monitors}" SelectedValuePath="Value" SelectedValue="{Binding Monitor}"
                                  MinWidth="320" HorizontalAlignment="Left" IsEnabled="{Binding CaptureMonitor}" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Content="One window" IsChecked="{Binding CaptureWindow}" GroupName="capture" />
                        <StackPanel Grid.Column="1">
                            <ComboBox IsEditable="True" ItemsSource="{Binding Programs}" Text="{Binding Window, UpdateSourceTrigger=PropertyChanged}"
                                      MinWidth="320" HorizontalAlignment="Left" IsEnabled="{Binding CaptureWindow}" />
                            <TextBlock Text="Exe name or part of the window title. Capture stops when it closes and starts again when it reopens."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Frames per second" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.FpsChoices}" SelectedValuePath="Value" SelectedValue="{Binding Fps}"
                                  MinWidth="160" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Bitrate" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding BitrateMbps, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                        <TextBlock Grid.Column="2" Text="Mbps (20 is good for 1080p60; more for 1440p)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.HeightChoices}" SelectedValuePath="Value" SelectedValue="{Binding MaxHeight}"
                                  MinWidth="200" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Encoder" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.EncoderChoices}" SelectedValuePath="Value" SelectedValue="{Binding Encoder}"
                                  MinWidth="200" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="GPU" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding Adapter, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        <TextBlock Grid.Column="2" Text="0 is the first GPU; change only on PCs with several" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                    <CheckBox Content="Show the mouse pointer" IsChecked="{Binding Cursor}" Margin="0,0,0,10" />
                </StackPanel>

                <DockPanel Margin="0,20,0,8">
                    <Button Content="Look for programs and microphones again" Command="{Binding RescanCommand}" DockPanel.Dock="Right" />
                    <TextBlock Text="Audio tracks" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Each track is kept separately in the file; you choose which ones to mix when you export. The first track is what plain video players play." />
                <ItemsControl ItemsSource="{Binding Tracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TrackEditor}">
                            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" ToolTip="Track name" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:TrackEditor.Kinds}" SelectedValuePath="Value" SelectedValue="{Binding Kind}" Margin="0,0,8,0" />
                                    <DockPanel Grid.Column="2" Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibility}}">
                                        <Button Content="Add…" DockPanel.Dock="Right" Margin="6,0,0,0" Click="OnPickTarget" ToolTip="Pick from what is running or plugged in now" />
                                        <TextBox Text="{Binding Targets, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding TargetsHint}" />
                                    </DockPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="↑" Command="{Binding UpCommand}" ToolTip="Move up" MinWidth="32" Margin="0,0,4,0" />
                                        <Button Content="↓" Command="{Binding DownCommand}" ToolTip="Move down" MinWidth="32" Margin="0,0,4,0" />
                                        <Button Content="✕" Command="{Binding RemoveCommand}" ToolTip="Remove this track" MinWidth="32" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding TargetsHint}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                    <Button Content="Add track" Command="{Binding AddTrackCommand}" />
                    <TextBlock Text="Quality per track" Style="{StaticResource FieldLabel}" Margin="24,0,8,0" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.AudioBitrateChoices}" SelectedValuePath="Value" SelectedValue="{Binding AudioBitrate}" MinWidth="120" />
                </StackPanel>

                <TextBlock Text="Replay buffer" Style="{StaticResource SectionHeader}" />
                <CheckBox Content="Keep the replay buffer running while SplitTrack is open" IsChecked="{Binding ReplayEnabled}" Margin="0,0,0,10" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Clip length" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding BufferSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    <TextBlock Grid.Column="2" Text="seconds kept in memory (about 2.5 MB per second at 20 Mbps)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>

                <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="Click a box and press the keys. They work while a game has focus." Style="{StaticResource Caption}" Margin="0,0,0,10" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Save clip" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding SaveClipHotkey}" Width="200" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" Tag="SaveClipHotkey" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Start / stop recording" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding RecordHotkey}" Width="200" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" Tag="RecordHotkey" />
                    <Button Grid.Column="2" Content="None" Margin="8,0,0,0" Click="OnClearRecordHotkey" />
                </Grid>

                <TextBlock Text="App" Style="{StaticResource SectionHeader}" />
                <CheckBox Content="Start SplitTrack with Windows (in the tray)" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10" />
                <TextBlock Text="{Binding SettingsPath, StringFormat='Settings file: {0}'}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                <Button Content="Open logs folder" Command="{Binding OpenLogsCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"
                        ToolTip="The logs say what went wrong when something does" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
