<Window x:Class="SplitTrack.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SplitTrack.App.ViewModels"
        xmlns:views="clr-namespace:SplitTrack.App.Views"
        Title="SplitTrack" Width="1120" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Recorder strip -->
        <Border Style="{StaticResource Card}" Margin="16,16,16,8" DataContext="{Binding Recorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TrayState}" Value="Replay">
                                            <Setter Property="Fill" Value="{StaticResource LiveBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TrayState}" Value="Recording">
                                            <Setter Property="Fill" Value="{StaticResource RecordBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TrayState}" Value="Error">
                                            <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StateText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DetailText}" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding VideoText}" Margin="18,4,0,0" Style="{StaticResource Caption}" />
                    <ItemsControl ItemsSource="{Binding Meters}" Margin="18,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TrackMeter}">
                                <StackPanel Width="170" Margin="0,0,16,6">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <ProgressBar Value="{Binding Level, Mode=OneWay}" Maximum="1" Height="6" Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" ToolTip="{Binding Source}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0" MinWidth="210">
                    <Button Command="{Binding SaveClipCommand}" HorizontalAlignment="Stretch" Padding="12,6" Style="{DynamicResource AccentButtonStyle}">
                        <TextBlock Text="{Binding SaveClipHint}" />
                    </Button>
                    <Button Command="{Binding ToggleRecordingCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource RecordBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Start recording" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Text" Value="Stop recording" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding RecordHint}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding RecordingText}" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource RecordBrush}"
                               Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox Content="Replay buffer" IsChecked="{Binding ReplayOn}" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="16,0,16,16">
            <TabItem Header="Library">
                <Grid DataContext="{Binding Library}" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <RadioButton Content="All" Margin="0,0,8,0" MinWidth="0"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                            <RadioButton Content="Clips" Margin="0,0,8,0" MinWidth="0"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Clips}" />
                            <RadioButton Content="Recordings" MinWidth="0"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Recordings}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Button Content="Open folder" Command="{Binding OpenFolderCommand}" ToolTip="{Binding Root}" Margin="0,0,8,0" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="EntryList" Grid.Row="1" ItemsSource="{Binding Entries}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" views:SmoothScroll.IsEnabled="True" MouseDoubleClick="OnEntryDoubleClick" KeyDown="OnEntryKeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="6" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Margin" Value="0,0,4,4" />
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Open" FontWeight="SemiBold"
                                                      Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Show in folder"
                                                      Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Delete"
                                                      Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LibraryEntry}">
                                <StackPanel Width="256">
                                    <Grid Height="144">
                                        <Border CornerRadius="6" Background="#FF111111" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="Audio only" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsAudioOnly, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Background="#B0000000" CornerRadius="4" Padding="6,2" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding KindText}" Foreground="White" FontSize="11" />
                                        </Border>
                                        <Border Background="#B0000000" CornerRadius="4" Padding="6,2" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Visibility="{Binding DurationText, Converter={StaticResource NullToVisibility}}">
                                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <DockPanel Margin="2,8,2,0">
                                        <TextBlock Text="{Binding Game}" DockPanel.Dock="Right" Style="{StaticResource Caption}" MaxWidth="110" />
                                        <TextBlock Text="{Binding CreatedText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="2,2,2,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="{Binding Summary}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Caption}" FontSize="14"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
