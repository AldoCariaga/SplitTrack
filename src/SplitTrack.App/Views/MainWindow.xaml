<Window x:Class="SplitTrack.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SplitTrack.App.ViewModels"
        xmlns:views="clr-namespace:SplitTrack.App.Views"
        Title="SplitTrack" Width="1120" Height="800" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Pages: navigation on top, the page underneath -->
        <TabControl Style="{StaticResource NavTabs}">
            <TabItem AutomationProperties.Name="Library">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Library" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid DataContext="{Binding Library}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource SegmentedGroup}" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="All" Style="{StaticResource Segment}" GroupName="LibraryFilter"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                                <RadioButton Content="Clips" Style="{StaticResource Segment}" GroupName="LibraryFilter"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Clips}" />
                                <RadioButton Content="Recordings" Style="{StaticResource Segment}" GroupName="LibraryFilter"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Recordings}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}" />
                            <Button Command="{Binding OpenFolderCommand}" ToolTip="{Binding Root}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="Open folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RefreshCommand}" ToolTip="Refresh" AutomationProperties.Name="Refresh" MinWidth="36">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <ListBox x:Name="EntryList" Grid.Row="1" ItemsSource="{Binding Entries}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" views:SmoothScroll.IsEnabled="True" MouseDoubleClick="OnEntryDoubleClick" KeyDown="OnEntryKeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:FluidWrapPanel MinItemWidth="260" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Margin" Value="0,0,8,8" />
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Open" FontWeight="SemiBold"
                                                      Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Show in folder"
                                                      Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Delete" InputGestureText="Del"
                                                      Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LibraryEntry}">
                                <StackPanel>
                                    <!-- 16:9 at whatever width the column has -->
                                    <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource Scale}, ConverterParameter=0.5625}">
                                        <Border CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding IsAudioOnly, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="Audio only" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding KindText}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Visibility="{Binding DurationText, Converter={StaticResource NullToVisibility}}">
                                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource Timecode}" />
                                        </Border>

                                        <!-- Quick actions while the card is hovered or selected -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Style="{StaticResource OverlayButton}" Content="&#xE838;" Margin="0,0,6,0"
                                                    ToolTip="Show in folder" AutomationProperties.Name="Show in folder" Focusable="False"
                                                    Command="{Binding Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource OverlayButton}" Content="&#xE74D;"
                                                    ToolTip="Delete (Del)" AutomationProperties.Name="Delete" Focusable="False"
                                                    Command="{Binding Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                    <DockPanel Margin="2,10,2,0">
                                        <TextBlock Text="{Binding Game}" DockPanel.Dock="Right" Style="{StaticResource Caption}" MaxWidth="110" VerticalAlignment="Bottom" />
                                        <TextBlock Text="{Binding CreatedText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="2,2,2,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty: say how to get something here -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Title}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding DataContext.Recorder.ClipHint, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource Secondary}" TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.Name="Settings">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>

        <!-- Recorder dock: what is being captured right now, and what you can do about it -->
        <Border Grid.Row="1" DataContext="{Binding Recorder}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Rectangle Style="{StaticResource StateStrip}" />
                <Grid Margin="24,14,24,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- State, then what the buffer holds and what video is captured -->
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Ellipse Style="{StaticResource StateDot}" Margin="0,1,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding StateText}" Style="{StaticResource Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Style="{StaticResource RecChip}" Margin="12,0,0,0"
                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="REC" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding RecordingText}" Style="{StaticResource Timecode}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2,0,0">
                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource Secondary}" FontSize="12"
                                       Visibility="{Binding DetailText, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Text="{Binding MetaText}" Style="{StaticResource Caption}" Opacity="0.8" Margin="0,1,0,0" ToolTip="{Binding MetaText}"
                                       Visibility="{Binding MetaText, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Replay buffer | Record | Save clip (the main action, rightmost) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <CheckBox Content="Replay buffer" IsChecked="{Binding ReplayOn}" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  ToolTip="Keeps the last seconds in memory so Save clip can keep them" />
                        <Rectangle Style="{StaticResource VDivider}" />
                        <Button Command="{Binding ToggleRecordingCommand}" Padding="12,7" MinWidth="110">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="AutomationProperties.Name" Value="Start recording" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="AutomationProperties.Name" Value="Stop recording" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12" Fill="{StaticResource RecordBrush}"
                                             Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{StaticResource RecordBrush}"
                                               Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Record" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="Text" Value="Stop" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding RecordHint}" Style="{StaticResource Timecode}" Opacity="0.65" FontSize="12" Margin="10,0,0,0"
                                           Visibility="{Binding RecordHint, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveClipCommand}" Padding="14,7" Margin="8,0,0,0" MinWidth="130"
                                Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="Save clip">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE78C;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Save clip" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SaveClipHint}" Style="{StaticResource Timecode}" Opacity="0.75" FontSize="12" Margin="10,0,0,0"
                                           Visibility="{Binding SaveClipHint, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- One meter per track, in the track's colour, in equal columns across the width -->
                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Meters}" Margin="20,14,0,0" Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Meters.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:FluidWrapPanel MinItemWidth="240" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TrackMeter}">
                                <StackPanel Margin="0,0,24,6">
                                    <DockPanel>
                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Fill="{Binding ColorIndex, Converter={StaticResource TrackColor}}" />
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0" MaxWidth="120"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" ToolTip="{Binding Source}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding Level, Mode=OneWay}" Margin="0,6,0,0"
                                                 Foreground="{Binding ColorIndex, Converter={StaticResource TrackColor}}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSignal}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
